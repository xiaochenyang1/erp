    {
      "name": "02-采购模块",
      "item": [
        {
          "name": "创建采购订单",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码为200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "var jsonData = pm.response.json();",
                  "pm.collectionVariables.set('purchaseOrderId', jsonData.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": 1,\n  \"orderDate\": \"2026-06-16\",\n  \"expectedDate\": \"2026-06-30\",\n  \"items\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 100,\n      \"price\": 10.00\n    }\n  ],\n  \"remark\": \"测试采购订单\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/purchase/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase", "orders"]
            }
          }
        },
        {
          "name": "提交审批",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/purchase/orders/{{purchaseOrderId}}/submit",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase", "orders", "{{purchaseOrderId}}", "submit"]
            }
          }
        },
        {
          "name": "审批通过",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/purchase/orders/{{purchaseOrderId}}/approve",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase", "orders", "{{purchaseOrderId}}", "approve"]
            }
          }
        },
        {
          "name": "关闭订单（新功能）",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('状态码为200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('状态变为CLOSED', function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data.status).to.eql('CLOSED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/purchase/orders/{{purchaseOrderId}}/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "purchase", "orders", "{{purchaseOrderId}}", "close"]
