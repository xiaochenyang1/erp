                  ]
                },
                "description": "查询盘点列表 - 新增接口测试"
              }
            },
            {
              "name": "生成调整",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "pm.test('状态码为200', function() {",
                      "    pm.response.to.have.status(200);",
                      "});",
                      "",
                      "pm.test('状态变为ADJUSTED', function() {",
                      "    var jsonData = pm.response.json();",
                      "    pm.expect(jsonData.data.status).to.eql('ADJUSTED');",
                      "});"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/checks/{{checkId}}/adjust",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "inventory", "checks", "{{checkId}}", "adjust"]
                }
              }
            }
          ]
        },
