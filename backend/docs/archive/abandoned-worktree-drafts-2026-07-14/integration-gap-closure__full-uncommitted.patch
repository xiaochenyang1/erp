+import com.tuowei.erp.finance.voucher.model.VoucherEntity;
+import com.tuowei.erp.finance.voucher.model.VoucherEntryEntity;
+import com.tuowei.erp.finance.voucher.service.VoucherCommandService;
+import com.tuowei.erp.finance.voucher.service.VoucherNumberService;
+import com.tuowei.erp.finance.voucher.web.VoucherCreateRequest;
+import com.tuowei.erp.finance.voucher.web.VoucherEntryCreateRequest;
+import org.apache.ibatis.builder.MapperBuilderAssistant;
+import org.junit.jupiter.api.BeforeAll;
+import org.junit.jupiter.api.Test;
+import org.mockito.ArgumentCaptor;
+
+import java.math.BigDecimal;
+import java.time.LocalDate;
+import java.time.LocalDateTime;
+import java.util.List;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+import static org.mockito.ArgumentMatchers.any;
+import static org.mockito.Mockito.mock;
+import static org.mockito.Mockito.never;
+import static org.mockito.Mockito.verify;
+import static org.mockito.Mockito.when;
+
+@SuppressWarnings({"unchecked", "rawtypes"})
+class VoucherCommandServiceTest {
+
+    private static final AuditMetadata AUDIT = new AuditMetadata(
+            9801L,
+            101L,
+            202L,
+            LocalDateTime.of(2026, 6, 18, 9, 0)
+    );
+
+    private static final Long CASH_SUBJECT_ID = 910001L;
+    private static final Long INCOME_SUBJECT_ID = 910005L;
+
+    private final VoucherMapper voucherMapper = mock(VoucherMapper.class);
+    private final VoucherEntryMapper voucherEntryMapper = mock(VoucherEntryMapper.class);
+    private final VoucherNumberService voucherNumberService = mock(VoucherNumberService.class);
+    private final AccountSubjectService accountSubjectService = mock(AccountSubjectService.class);
+    private final AuditMetadataFactory auditMetadataFactory = mock(AuditMetadataFactory.class);
+
+    @BeforeAll
+    static void initTableInfo() {
+        initTableInfo(VoucherEntity.class);
+        initTableInfo(VoucherEntryEntity.class);
+    }
+
+    @Test
+    void createManualVoucherPersistsBalancedVoucherAndEntries() {
+        when(auditMetadataFactory.current()).thenReturn(AUDIT);
+        when(voucherNumberService.nextVoucherNo(LocalDate.of(2026, 6, 18))).thenReturn("VO202606180001");
+        when(accountSubjectService.requireActiveSubject(CASH_SUBJECT_ID, "会计科目不存在或已停用"))
+                .thenReturn(subject(CASH_SUBJECT_ID, "1002", "银行存款"));
+        when(accountSubjectService.requireActiveSubject(INCOME_SUBJECT_ID, "会计科目不存在或已停用"))
+                .thenReturn(subject(INCOME_SUBJECT_ID, "6001", "主营业务收入"));
+        when(voucherMapper.updateById(any(VoucherEntity.class))).thenReturn(1);
+
+        service().create(createRequest(new BigDecimal("128.50"), new BigDecimal("128.50")));
+
+        ArgumentCaptor<VoucherEntity> voucherCaptor = ArgumentCaptor.forClass(VoucherEntity.class);
+        verify(voucherMapper).insert(voucherCaptor.capture());
+        VoucherEntity voucher = voucherCaptor.getValue();
+        assertThat(voucher.getCompanyId()).isEqualTo(AUDIT.companyId());
+        assertThat(voucher.getAccountBookId()).isEqualTo(AUDIT.accountBookId());
+        assertThat(voucher.getVoucherNo()).isEqualTo("VO202606180001");
+        assertThat(voucher.getSourceType()).isEqualTo("MANUAL");
+        assertThat(voucher.getBizDate()).isEqualTo(LocalDate.of(2026, 6, 18));
+        assertThat(voucher.getAmount()).isEqualByComparingTo("128.50");
+        assertThat(voucher.getStatus()).isEqualTo("DRAFT");
+
+        ArgumentCaptor<VoucherEntryEntity> entryCaptor = ArgumentCaptor.forClass(VoucherEntryEntity.class);
+        verify(voucherEntryMapper, org.mockito.Mockito.times(2)).insert(entryCaptor.capture());
+        List<VoucherEntryEntity> entries = entryCaptor.getAllValues();
+        assertThat(entries).extracting(VoucherEntryEntity::getLineNo).containsExactly(1, 2);
+        assertThat(entries).extracting(VoucherEntryEntity::getSubjectCode).containsExactly("1002", "6001");
+        assertThat(entries.get(0).getDebitAmount()).isEqualByComparingTo("128.50");
+        assertThat(entries.get(0).getCreditAmount()).isEqualByComparingTo("0.00");
+        assertThat(entries.get(1).getDebitAmount()).isEqualByComparingTo("0.00");
+        assertThat(entries.get(1).getCreditAmount()).isEqualByComparingTo("128.50");
+    }
+
+    @Test
+    void createManualVoucherRejectsUnbalancedEntries() {
+        when(auditMetadataFactory.current()).thenReturn(AUDIT);
+
+        assertThatThrownBy(() -> service().create(createRequest(new BigDecimal("128.50"), new BigDecimal("120.00"))))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessage("借贷金额必须平衡");
+
+        verify(voucherMapper, never()).insert(any(VoucherEntity.class));
+        verify(voucherEntryMapper, never()).insert(any(VoucherEntryEntity.class));
+    }
+
+    @Test
+    void approvePostAndCancelUseTenantScopedVoucherAndValidStatusTransitions() {
+        when(auditMetadataFactory.current()).thenReturn(AUDIT);
+        VoucherEntity draft = voucher(1001L, "DRAFT");
+        VoucherEntity approved = voucher(1001L, "APPROVED");
+        VoucherEntity posted = voucher(1001L, "POSTED");
+        when(voucherMapper.selectById(1001L)).thenReturn(draft, approved, posted);
+        when(voucherMapper.updateById(any(VoucherEntity.class))).thenReturn(1);
+
+        service().approve(1001L);
+        service().post(1001L);
+
+        assertThatThrownBy(() -> service().cancel(1001L))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessage("已过账凭证不能作废");
+
+        ArgumentCaptor<VoucherEntity> updates = ArgumentCaptor.forClass(VoucherEntity.class);
+        verify(voucherMapper, org.mockito.Mockito.times(2)).updateById(updates.capture());
+        assertThat(updates.getAllValues()).extracting(VoucherEntity::getStatus)
+                .containsExactly("APPROVED", "POSTED");
+    }
+
+    @Test
+    void detailActionsRejectVoucherFromDifferentAccountBook() {
+        when(auditMetadataFactory.current()).thenReturn(AUDIT);
+        when(voucherMapper.selectById(1002L)).thenReturn(voucher(1002L, "DRAFT", 999L));
+
+        assertThatThrownBy(() -> service().approve(1002L))
+                .isInstanceOf(IllegalArgumentException.class)
+                .hasMessage("凭证不存在");
+    }
+
+    private VoucherCommandService service() {
+        return new VoucherCommandService(
+                voucherMapper,
+                voucherEntryMapper,
+                voucherNumberService,
+                accountSubjectService,
+                auditMetadataFactory
+        );
+    }
+
+    private VoucherCreateRequest createRequest(BigDecimal debitAmount, BigDecimal creditAmount) {
+        return new VoucherCreateRequest(
+                "TRANSFER",
+                LocalDate.of(2026, 6, 18),
+                List.of(
+                        new VoucherEntryCreateRequest(CASH_SUBJECT_ID, debitAmount, BigDecimal.ZERO, "借方"),
+                        new VoucherEntryCreateRequest(INCOME_SUBJECT_ID, BigDecimal.ZERO, creditAmount, "贷方")
+                ),
+                "手工凭证"
+        );
+    }
+
+    private AccountSubjectEntity subject(Long id, String code, String name) {
+        AccountSubjectEntity entity = new AccountSubjectEntity();
+        entity.setId(id);
+        entity.setCompanyId(AUDIT.companyId());
+        entity.setAccountBookId(AUDIT.accountBookId());
+        entity.setSubjectCode(code);
+        entity.setSubjectName(name);
+        entity.setStatus("ACTIVE");
+        entity.setDeletedFlag(0);
+        return entity;
+    }
+
+    private VoucherEntity voucher(Long id, String status) {
+        return voucher(id, status, AUDIT.accountBookId());
+    }
+
+    private VoucherEntity voucher(Long id, String status, Long accountBookId) {
+        VoucherEntity entity = new VoucherEntity();
+        entity.setId(id);
+        entity.setCompanyId(AUDIT.companyId());
+        entity.setAccountBookId(accountBookId);
+        entity.setVoucherNo("VO-" + id);
+        entity.setSourceType("MANUAL");
+        entity.setBizDate(LocalDate.of(2026, 6, 18));
+        entity.setAmount(new BigDecimal("128.50"));
+        entity.setStatus(status);
+        entity.setDeletedFlag(0);
+        entity.setVersion(0);
+        return entity;
+    }
+
+    private static void initTableInfo(Class<?> entityClass) {
+        if (TableInfoHelper.getTableInfo(entityClass) != null) {
+            return;
+        }
+        MapperBuilderAssistant assistant = new MapperBuilderAssistant(new MybatisConfiguration(), entityClass.getName());
+        assistant.setCurrentNamespace(entityClass.getName());
+        TableInfoHelper.initTableInfo(assistant, entityClass);
+    }
+}
