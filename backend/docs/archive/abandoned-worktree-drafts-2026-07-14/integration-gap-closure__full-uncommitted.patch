@@ -0,0 +1,195 @@
+package com.tuowei.erp.finance.voucher.service;
+
+import com.tuowei.erp.common.math.ScalePrecision;
+import com.tuowei.erp.common.security.AuditMetadata;
+import com.tuowei.erp.common.security.AuditMetadataFactory;
+import com.tuowei.erp.finance.subject.model.AccountSubjectEntity;
+import com.tuowei.erp.finance.subject.service.AccountSubjectService;
+import com.tuowei.erp.finance.voucher.mapper.VoucherEntryMapper;
+import com.tuowei.erp.finance.voucher.mapper.VoucherMapper;
+import com.tuowei.erp.finance.voucher.model.VoucherEntity;
+import com.tuowei.erp.finance.voucher.model.VoucherEntryEntity;
+import com.tuowei.erp.finance.voucher.web.VoucherCreateRequest;
+import com.tuowei.erp.finance.voucher.web.VoucherEntryCreateRequest;
+import org.springframework.stereotype.Service;
+import org.springframework.transaction.annotation.Transactional;
+
+import java.math.BigDecimal;
+import java.time.LocalDateTime;
+import java.util.List;
+import java.util.Objects;
+
+@Service
+public class VoucherCommandService {
+
+    private static final BigDecimal ZERO_AMOUNT = ScalePrecision.amount(BigDecimal.ZERO);
+
+    private final VoucherMapper voucherMapper;
+    private final VoucherEntryMapper voucherEntryMapper;
+    private final VoucherNumberService voucherNumberService;
+    private final AccountSubjectService accountSubjectService;
+    private final AuditMetadataFactory auditMetadataFactory;
+
+    public VoucherCommandService(
+            VoucherMapper voucherMapper,
+            VoucherEntryMapper voucherEntryMapper,
+            VoucherNumberService voucherNumberService,
+            AccountSubjectService accountSubjectService,
+            AuditMetadataFactory auditMetadataFactory
+    ) {
+        this.voucherMapper = voucherMapper;
+        this.voucherEntryMapper = voucherEntryMapper;
+        this.voucherNumberService = voucherNumberService;
+        this.accountSubjectService = accountSubjectService;
+        this.auditMetadataFactory = auditMetadataFactory;
+    }
+
+    @Transactional
+    public VoucherEntity create(VoucherCreateRequest request) {
+        AuditMetadata audit = auditMetadataFactory.current();
+        LocalDateTime now = audit.now();
+        List<VoucherEntryCreateRequest> entries = safeEntries(request.entries());
+        if (entries.size() < 2) {
+            throw new IllegalArgumentException("凭证至少需要两条分录");
+        }
+
+        BigDecimal totalDebit = sumDebit(entries);
+        BigDecimal totalCredit = sumCredit(entries);
+        if (totalDebit.compareTo(totalCredit) != 0 || totalDebit.compareTo(ZERO_AMOUNT) <= 0) {
+            throw new IllegalArgumentException("借贷金额必须平衡");
+        }
+
+        VoucherEntity voucher = new VoucherEntity();
+        voucher.setCompanyId(audit.companyId());
+        voucher.setAccountBookId(audit.accountBookId());
+        voucher.setVoucherNo(voucherNumberService.nextVoucherNo(request.voucherDate()));
+        voucher.setSourceType("MANUAL");
+        voucher.setSourceNo(voucher.getVoucherNo());
+        voucher.setBizDate(request.voucherDate());
+        voucher.setAmount(totalDebit);
+        voucher.setStatus("DRAFT");
+        voucher.setDeletedFlag(0);
+        voucher.setRemark(request.remark());
+        setAudit(voucher, audit, now);
+        voucherMapper.insert(voucher);
+        voucher.setSourceId(voucher.getId());
+        voucherMapper.updateById(voucher);
+
+        int lineNo = 1;
+        for (VoucherEntryCreateRequest entryRequest : entries) {
+            AccountSubjectEntity subject = accountSubjectService.requireActiveSubject(entryRequest.subjectId(), "会计科目不存在或已停用");
+            if (!Objects.equals(subject.getCompanyId(), audit.companyId())
+                    || !Objects.equals(subject.getAccountBookId(), audit.accountBookId())) {
+                throw new IllegalArgumentException("会计科目不存在");
+            }
+            VoucherEntryEntity entry = new VoucherEntryEntity();
+            entry.setCompanyId(audit.companyId());
+            entry.setAccountBookId(audit.accountBookId());
+            entry.setVoucherId(voucher.getId());
+            entry.setBizDate(request.voucherDate());
+            entry.setLineNo(lineNo++);
+            entry.setSubjectId(subject.getId());
+            entry.setSubjectCode(subject.getSubjectCode());
+            entry.setSubjectName(subject.getSubjectName());
+            entry.setDebitAmount(scale(entryRequest.debitAmount()));
+            entry.setCreditAmount(scale(entryRequest.creditAmount()));
+            entry.setSummary(entryRequest.summary());
+            setAudit(entry, audit, now);
+            voucherEntryMapper.insert(entry);
+        }
+        return voucher;
+    }
+
+    @Transactional
+    public VoucherEntity approve(Long id) {
+        return transition(id, "APPROVED");
+    }
+
+    @Transactional
+    public VoucherEntity post(Long id) {
+        VoucherEntity voucher = requireVoucher(id);
+        if (!"APPROVED".equals(voucher.getStatus())) {
+            throw new IllegalArgumentException("只有已审批凭证可以过账");
+        }
+        voucher.setStatus("POSTED");
+        return saveTransition(voucher);
+    }
+
+    @Transactional
+    public VoucherEntity cancel(Long id) {
+        VoucherEntity voucher = requireVoucher(id);
+        if ("POSTED".equals(voucher.getStatus())) {
+            throw new IllegalArgumentException("已过账凭证不能作废");
+        }
+        voucher.setStatus("CANCELLED");
+        return saveTransition(voucher);
+    }
+
+    private VoucherEntity transition(Long id, String status) {
+        VoucherEntity voucher = requireVoucher(id);
+        if (!"DRAFT".equals(voucher.getStatus())) {
+            throw new IllegalArgumentException("只有草稿凭证可以审批");
+        }
+        voucher.setStatus(status);
+        return saveTransition(voucher);
+    }
+
+    private VoucherEntity saveTransition(VoucherEntity voucher) {
+        AuditMetadata audit = auditMetadataFactory.current();
+        voucher.setUpdatedBy(audit.userId());
+        voucher.setUpdatedTime(audit.now());
+        if (voucherMapper.updateById(voucher) != 1) {
+            throw new IllegalArgumentException("凭证已被其他操作修改，请刷新后重试");
+        }
+        return voucher;
+    }
+
+    private VoucherEntity requireVoucher(Long id) {
+        VoucherEntity voucher = voucherMapper.selectById(id);
+        AuditMetadata audit = auditMetadataFactory.current();
+        if (voucher == null || voucher.getDeletedFlag() == null || voucher.getDeletedFlag() != 0
+                || !Objects.equals(voucher.getCompanyId(), audit.companyId())
+                || !Objects.equals(voucher.getAccountBookId(), audit.accountBookId())) {
+            throw new IllegalArgumentException("凭证不存在");
+        }
+        return voucher;
+    }
+
+    private List<VoucherEntryCreateRequest> safeEntries(List<VoucherEntryCreateRequest> entries) {
+        return entries == null ? List.of() : entries;
+    }
+
+    private BigDecimal sumDebit(List<VoucherEntryCreateRequest> entries) {
+        return ScalePrecision.amount(entries.stream()
+                .map(VoucherEntryCreateRequest::debitAmount)
+                .map(ScalePrecision::zeroDefault)
+                .reduce(BigDecimal.ZERO, BigDecimal::add));
+    }
+
+    private BigDecimal sumCredit(List<VoucherEntryCreateRequest> entries) {
+        return ScalePrecision.amount(entries.stream()
+                .map(VoucherEntryCreateRequest::creditAmount)
+                .map(ScalePrecision::zeroDefault)
+                .reduce(BigDecimal.ZERO, BigDecimal::add));
+    }
+
+    private BigDecimal scale(BigDecimal amount) {
+        return ScalePrecision.amount(ScalePrecision.zeroDefault(amount));
+    }
+
+    private void setAudit(VoucherEntity entity, AuditMetadata audit, LocalDateTime now) {
+        entity.setCreatedBy(audit.userId());
+        entity.setCreatedTime(now);
+        entity.setUpdatedBy(audit.userId());
+        entity.setUpdatedTime(now);
+        entity.setVersion(0);
+    }
+
+    private void setAudit(VoucherEntryEntity entity, AuditMetadata audit, LocalDateTime now) {
+        entity.setCreatedBy(audit.userId());
+        entity.setCreatedTime(now);
+        entity.setUpdatedBy(audit.userId());
+        entity.setUpdatedTime(now);
+        entity.setVersion(0);
+    }
+}
