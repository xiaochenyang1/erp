+package com.tuowei.erp.finance.voucher.service;
+
+import com.tuowei.erp.system.config.service.SequenceNumberGenerator;
+import org.springframework.stereotype.Component;
+
+import java.time.LocalDate;
+
+@Component
+public class VoucherNumberService {
+
+    private final SequenceNumberGenerator sequenceNumberGenerator;
+
+    public VoucherNumberService(SequenceNumberGenerator sequenceNumberGenerator) {
+        this.sequenceNumberGenerator = sequenceNumberGenerator;
+    }
+
+    public String nextVoucherNo(LocalDate bizDate) {
+        return sequenceNumberGenerator.nextNumber("FIN_VOUCHER", "记账凭证", bizDate);
+    }
+}
