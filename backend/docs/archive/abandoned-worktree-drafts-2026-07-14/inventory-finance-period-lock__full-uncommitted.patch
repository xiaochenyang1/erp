index 0000000..55bdfcb
--- /dev/null
+++ b/src/test/java/com/tuowei/erp/finance/voucher/VoucherAuditPostingMigrationTest.java
@@ -0,0 +1,46 @@
+package com.tuowei.erp.finance.voucher;
+
+import org.assertj.core.api.Assertions;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.jdbc.core.JdbcTemplate;
+import org.springframework.test.context.ActiveProfiles;
+
+@SpringBootTest
+@ActiveProfiles("test")
+class VoucherAuditPostingMigrationTest {
+
+    @Autowired
+    private JdbcTemplate jdbcTemplate;
+
+    @Test
+    void voucherTableHasAuditAndPostingColumns() {
+        Assertions.assertThat(columnExists("fin_voucher", "audited_by")).isTrue();
+        Assertions.assertThat(columnExists("fin_voucher", "audited_time")).isTrue();
+        Assertions.assertThat(columnExists("fin_voucher", "posted_by")).isTrue();
+        Assertions.assertThat(columnExists("fin_voucher", "posted_time")).isTrue();
+        Assertions.assertThat(columnExists("fin_voucher", "unposted_by")).isTrue();
+        Assertions.assertThat(columnExists("fin_voucher", "unposted_time")).isTrue();
+    }
+
+    @Test
+    void voucherPermissionsAreSeeded() {
+        Integer count = jdbcTemplate.queryForObject("""
+                select count(*)
+                from sys_menu
+                where permission in ('finance:voucher:view', 'finance:voucher:audit', 'finance:voucher:post')
+                """, Integer.class);
+        Assertions.assertThat(count).isEqualTo(3);
+    }
+
+    private boolean columnExists(String tableName, String columnName) {
+        Integer count = jdbcTemplate.queryForObject("""
+                select count(*)
+                from information_schema.columns
+                where lower(table_name) = ?
+                  and lower(column_name) = ?
+                """, Integer.class, tableName, columnName);
+        return count != null && count == 1;
+    }
+}
