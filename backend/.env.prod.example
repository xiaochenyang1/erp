# Copy this file to .env.prod and replace every CHANGE_ME value before deployment.
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_32_chars_min
MYSQL_DATABASE=erp_server
MYSQL_USER=erp_app
MYSQL_PASSWORD=CHANGE_ME_app_password_32_chars_min

ERP_DATASOURCE_URL=jdbc:mysql://mysql:3306/erp_server?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
ERP_DATASOURCE_USERNAME=erp_app
ERP_DATASOURCE_PASSWORD=CHANGE_ME_app_password_32_chars_min

MYSQL_PORT=3306
MYSQL_BIND_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_BIND_HOST=127.0.0.1
ERP_SERVER_PORT=8080
ERP_SERVER_BIND_HOST=127.0.0.1

ERP_REDIS_PASSWORD=CHANGE_ME_redis_password_32_chars_min
ERP_REDIS_TIMEOUT=5s
ERP_JWT_SECRET=CHANGE_ME_jwt_secret_at_least_48_bytes_long_for_prod
ERP_JWT_ACCESS_TOKEN_TTL_SECONDS=7200
ERP_JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
ERP_CORS_ALLOWED_ORIGINS=https://erp.example.com
ERP_TRUSTED_PROXIES=

# Required only until the first successful production bootstrap marks
# erp.bootstrap.admin-password-initialized=true in sys_config.
ERP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password_12_chars_min

ERP_DB_POOL_MAX_SIZE=20
ERP_DB_POOL_MIN_IDLE=5
ERP_DB_CONNECTION_TIMEOUT_MS=30000
ERP_DB_VALIDATION_TIMEOUT_MS=5000
ERP_TOMCAT_THREADS_MAX=200
ERP_TOMCAT_THREADS_MIN_SPARE=10
ERP_HTTP_COMPRESSION_ENABLED=true
ERP_HTTP_COMPRESSION_MIN_RESPONSE_SIZE=2KB
ERP_ATTACHMENT_MAX_FILE_SIZE_BYTES=20971520
ERP_IDEMPOTENCY_ENABLED=true
ERP_IDEMPOTENCY_TTL_SECONDS=86400
ERP_IDEMPOTENCY_MAX_REPLAY_BODY_BYTES=1048576
ERP_IDEMPOTENCY_MAX_REQUEST_BODY_BYTES=1048576
ERP_IMPORT_MAX_FILE_SIZE_BYTES=5242880
ERP_IMPORT_MAX_ROWS=5000
ERP_IMPORT_MAX_CELL_LENGTH=4096
ERP_IMPORT_COMMIT_BATCH_SIZE=500
ERP_REPORT_MAX_EXPORT_ROWS=5000
ERP_REPORT_EXPORT_BATCH_SIZE=500
ERP_PRINCIPAL_CACHE_INVALIDATION_MODE=redis
ERP_FLYWAY_BASELINE_ON_MIGRATE=false
ERP_DOCKER_LOG_MAX_SIZE=50m
ERP_DOCKER_LOG_MAX_FILE=5
