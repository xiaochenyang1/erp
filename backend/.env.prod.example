# Copy this file to .env.prod and replace every CHANGE_ME value before deployment.
MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password_32_chars_min
MYSQL_DATABASE=erp_server
MYSQL_USER=erp_app
MYSQL_PASSWORD=CHANGE_ME_app_password_32_chars_min

ERP_DATASOURCE_URL=jdbc:mysql://mysql:3306/erp_server?useUnicode=true&characterEncoding=utf8mb4&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
ERP_DATASOURCE_USERNAME=erp_app
ERP_DATASOURCE_PASSWORD=CHANGE_ME_app_password_32_chars_min

MYSQL_PORT=3306
MYSQL_BIND_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_BIND_HOST=127.0.0.1
ERP_SERVER_PORT=8080
ERP_SERVER_BIND_HOST=127.0.0.1

ERP_REDIS_PASSWORD=CHANGE_ME_redis_password_32_chars_min
ERP_REDIS_TIMEOUT=5s
ERP_JWT_SECRET=CHANGE_ME_jwt_secret_at_least_48_bytes_long_for_prod
ERP_JWT_ACCESS_TOKEN_TTL_SECONDS=7200
ERP_JWT_REFRESH_TOKEN_TTL_SECONDS=1209600
ERP_CORS_ALLOWED_ORIGINS=https://erp.example.com
ERP_TRUSTED_PROXIES=

# Required only until the first successful production bootstrap marks
# erp.bootstrap.admin-password-initialized=true in sys_config.
ERP_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_admin_password_12_chars_min

ERP_DB_POOL_MAX_SIZE=20
ERP_DB_POOL_MIN_IDLE=5
ERP_DB_CONNECTION_TIMEOUT_MS=30000
ERP_DB_VALIDATION_TIMEOUT_MS=5000
ERP_TOMCAT_THREADS_MAX=200
ERP_TOMCAT_THREADS_MIN_SPARE=10
ERP_HTTP_COMPRESSION_ENABLED=true
ERP_HTTP_COMPRESSION_MIN_RESPONSE_SIZE=2KB
ERP_ATTACHMENT_MAX_FILE_SIZE_BYTES=20971520
ERP_IDEMPOTENCY_ENABLED=true
ERP_IDEMPOTENCY_TTL_SECONDS=86400
ERP_IDEMPOTENCY_MAX_REPLAY_BODY_BYTES=1048576
ERP_IDEMPOTENCY_MAX_REQUEST_BODY_BYTES=1048576
ERP_IMPORT_MAX_FILE_SIZE_BYTES=5242880
ERP_IMPORT_MAX_ROWS=5000
ERP_IMPORT_MAX_CELL_LENGTH=4096
ERP_IMPORT_COMMIT_BATCH_SIZE=500
ERP_REPORT_MAX_EXPORT_ROWS=5000
ERP_REPORT_EXPORT_BATCH_SIZE=500
ERP_PRINCIPAL_CACHE_INVALIDATION_MODE=redis
ERP_PRINCIPAL_CACHE_TTL_SECONDS=60
ERP_SCOPED_USER_CACHE_TTL_SECONDS=60
ERP_WORKFLOW_TASK_TIMEOUT_HOURS=24

# Approval notification webhook is best-effort. The database URL
# notification.webhook.url remains blank by default, which disables delivery.
ERP_NOTIFICATION_WEBHOOK_ENABLED=true
ERP_NOTIFICATION_WEBHOOK_POOL_SIZE=2
ERP_NOTIFICATION_WEBHOOK_QUEUE_CAPACITY=500
ERP_NOTIFICATION_WEBHOOK_REQUEST_TIMEOUT=5s
ERP_NOTIFICATION_WEBHOOK_ALLOWED_HOSTS=
ERP_NOTIFICATION_WEBHOOK_ALLOW_PRIVATE_ADDRESSES=false

# Exception-rule automation. The database lease keeps this scheduled job
# single-run across application instances; keep the TTL above the worst-case
# scan duration and monitor lease-acquisition failures.
ERP_EXCEPTION_RULE_SCHEDULER_ENABLED=true
ERP_EXCEPTION_RULE_SCHEDULER_FIXED_DELAY_MS=60000
ERP_EXCEPTION_RULE_SCHEDULER_INITIAL_DELAY_MS=60000
ERP_EXCEPTION_RULE_SCHEDULER_LEASE_ENABLED=true
ERP_EXCEPTION_RULE_SCHEDULER_LEASE_TTL_SECONDS=600
# The exception-rule scan still builds its system identity from one fixed
# company / account book pair, so a multi-book deployment only scans this pair.
ERP_EXCEPTION_RULE_SCHEDULER_SYSTEM_USER_ID=0
ERP_EXCEPTION_RULE_SCHEDULER_SYSTEM_COMPANY_ID=1
ERP_EXCEPTION_RULE_SCHEDULER_SYSTEM_ACCOUNT_BOOK_ID=1

# Contract expiry / low-execution alert scan. This job has no database lease,
# so every application instance runs its own scan; duplicate notifications are
# blocked by the sys_notification dedup_key unique index added in V155.
# ERP_CONTRACT_ALERT_SCHEDULER_SYSTEM_USER_ID is only the audit user id stamped
# on the generated notifications, not a login account.
ERP_CONTRACT_ALERT_SCHEDULER_ENABLED=true
ERP_CONTRACT_ALERT_SCHEDULER_FIXED_DELAY_MS=3600000
ERP_CONTRACT_ALERT_SCHEDULER_INITIAL_DELAY_MS=120000
ERP_CONTRACT_ALERT_SCHEDULER_EXPIRATION_WARNING_DAYS=30
ERP_CONTRACT_ALERT_SCHEDULER_LOW_EXECUTION_RATE=0.5
ERP_CONTRACT_ALERT_SCHEDULER_SYSTEM_USER_ID=0

ERP_FLYWAY_BASELINE_ON_MIGRATE=false
ERP_DOCKER_LOG_MAX_SIZE=50m
ERP_DOCKER_LOG_MAX_FILE=5
